# ====================================
# DailyBrief Environment Variables
# ====================================

# Django core
SECRET_KEY=your-django-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://frontend:3000

# PostgreSQL / Supabase
SUPABASE_DB_NAME=dailybrief
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-postgres-password-here
SUPABASE_DB_HOST=db
SUPABASE_DB_PORT=5432
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-api-key-here
DATABASE_URL=postgresql://your-db-user:your-db-password@db:5432/dailybrief?schema=auth

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# External APIs
NEWS_API_KEY=your-news-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Frontend app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# NextAuth / OAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
APPLE_ID=your-apple-services-id-here
APPLE_TEAM_ID=your-apple-team-id-here
APPLE_KEY_ID=your-apple-key-id-here
APPLE_SECRET=your-apple-private-key-here

# Email
EMAIL_FROM=noreply@example.com
EMAIL_SERVER=smtp://username:password@smtp.example.com:587
RESEND_API_KEY=your-resend-api-key-here

# Optional tuning
AI_RATE_LIMIT_CALLS_PER_MINUTE=150
AI_RATE_LIMIT_BURST_CAPACITY=50
DAILY_PIPELINE_BUDGET=200
PUBLISHER_PIPELINE_CAP=12
DIGEST_BATCH_SIZE=50
DIGEST_DEFAULT_TIMEZONE=UTC
DIGEST_MAX_COST_PER_USER=0.50
COMPOSE_PROJECT_NAME=dailybrief
