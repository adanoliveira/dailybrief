# Exclude large directories that aren't needed for backend build
frontend/
docs/
infra/
tests/
.git/
.github/

# Python
**/__pycache__/
**/*.py[cod]
**/*.pyc
**/*.pyo
**/*.pyd
**/venv/
**/env/
**/ENV/

# Logs and temporary files
**/*.log
**/logs/
**/debug.log
backend/debug.log
**/celerybeat-schedule*
**/celerybeat.pid
**/*.tmp
**/*.temp

# Database files
**/*.db
**/*.sqlite*
**/db.sqlite3

# Development files
**/.env
**/.env.*
.env
.env.*
**/.pytest_cache/
**/.coverage
**/htmlcov/
**/.tox/

# Editor files
**/.idea/
**/.vscode/
**/*.swp
**/*.swo
**/*~

# Build artifacts
**/node_modules/
**/.next/
**/dist/
**/build/
**/staticfiles/
**/media/

# Docker files (Railway doesn't need these)
**/Dockerfile*
**/.dockerignore
**/docker-compose*

# Project files
**/*.md
README.md
LICENSE
CONTRIBUTING.md 