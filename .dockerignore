# AGGRESSIVE EXCLUSION - Include only what we need for backend

# Exclude everything first
*
**/*

# Then explicitly include only backend essentials
!backend/
!backend/**

# Exclude within backend directory
backend/venv/
backend/env/
backend/ENV/
backend/__pycache__/
backend/**/__pycache__/
backend/*.py[cod]
backend/**/*.py[cod]
backend/*.pyc
backend/**/*.pyc
backend/*.log
backend/**/*.log
backend/debug.log
backend/logs/
backend/**logs/
backend/staticfiles/
backend/media/
backend/.pytest_cache/
backend/**/.pytest_cache/
backend/.coverage
backend/htmlcov/
backend/.tox/
backend/celerybeat-schedule*
backend/celerybeat.pid
backend/*.tmp
backend/*.temp
backend/*.db
backend/*.sqlite*
backend/db.sqlite3

# Exclude development tools
backend/.env
backend/.env.*
backend/Dockerfile*
backend/.dockerignore
backend/docker-compose*

# Exclude editor files
backend/.idea/
backend/.vscode/
backend/*.swp
backend/*.swo
backend/*~

# Exclude test files (optional - remove if you need tests)
backend/tests/
backend/**/tests/ 