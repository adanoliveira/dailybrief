// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./local-app.db"
}

// NextAuth models (simplified for local storage)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Custom model to track email verification tokens
model EmailVerificationRequest {
  id          String   @id @default(cuid())
  email       String
  createdAt   DateTime @default(now())
  invalidated Boolean  @default(false)

  @@index([email])
}

// ===============================================
// LOCAL DATA STORAGE MODELS
// ===============================================

// Local user preferences and profile
model LocalUserProfile {
  id                     String  @id @default(cuid())
  userId                 String  @unique // Django user ID
  publicId               String  @unique // Django public_id
  email                  String
  name                   String
  hasCompletedOnboarding Boolean @default(false)

  // Preferences
  topics        String // JSON array of topic IDs
  topicsDetails String? // JSON array of topic objects
  regions       String // JSON array of region IDs  
  languages     String // JSON array of language IDs
  publications  String // JSON array of publication IDs

  // Sync metadata
  lastSyncAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Related data
  feedSyncs FeedSync[]

  @@index([userId])
  @@index([publicId])
}

// Local article storage
model LocalArticle {
  id            String   @id @default(cuid())
  backendId     String   @unique // Backend article ID
  title         String
  visualTitle   String? // Clean title without publication
  description   String
  content       String? // Full article content
  url           String
  imageUrl      String?
  publishedAt   DateTime
  readTime      Int?
  isTopHeadline Boolean  @default(false)

  // Source information
  sourceName    String
  sourceLogoUrl String?

  // Content metadata  
  summary        String? // JSON summary object
  richContent    String? // JSON rich content
  contentStatus  String?
  contentQuality String? // JSON quality metrics

  // Topics and categorization
  topics String? // JSON array of topic objects

  // Local metadata
  isRead  Boolean   @default(false)
  isSaved Boolean   @default(false)
  readAt  DateTime?
  savedAt DateTime?

  // Sync metadata
  lastSyncAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  feedItems FeedItem[]

  @@index([backendId])
  @@index([publishedAt])
  @@index([isTopHeadline])
  @@index([isRead])
  @@index([isSaved])
}

// Feed sync tracking and metadata
model FeedSync {
  id        String  @id @default(cuid())
  userId    String
  feedType  String // 'personalized', 'world'
  topicSlug String? // null for 'for-you' or 'all'

  // Sync status
  lastSyncAt     DateTime
  nextSyncAt     DateTime? // Scheduled next sync
  isStale        Boolean   @default(false)
  syncInProgress Boolean   @default(false)

  // Pagination info from last sync
  lastPage   Int     @default(1)
  hasMore    Boolean @default(true)
  totalItems Int?

  // Sync metadata
  syncCount         Int     @default(0)
  lastSyncDuration  Int? // Milliseconds
  lastError         String?
  consecutiveErrors Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userProfile LocalUserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  feedItems   FeedItem[]

  @@unique([userId, feedType, topicSlug])
  @@index([userId, feedType])
  @@index([lastSyncAt])
  @@index([nextSyncAt])
  @@index([isStale])
}

// Join table for feed items (articles in feeds)
model FeedItem {
  id             String   @id @default(cuid())
  feedSyncId     String
  articleId      String
  position       Int // Position in feed
  relevanceScore Float? // For personalized feeds
  addedAt        DateTime @default(now())

  // Relations
  feedSync FeedSync     @relation(fields: [feedSyncId], references: [id], onDelete: Cascade)
  article  LocalArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([feedSyncId, articleId])
  @@index([feedSyncId, position])
  @@index([articleId])
}

// Background sync job queue
model SyncJob {
  id        String  @id @default(cuid())
  type      String // 'user_sync', 'feed_sync', 'article_detail'
  userId    String?
  feedType  String?
  topicSlug String?
  articleId String?

  // Job status
  status      String // 'pending', 'running', 'completed', 'failed'
  priority    Int    @default(5) // 1-10, lower = higher priority
  attempts    Int    @default(0)
  maxAttempts Int    @default(3)

  // Scheduling
  scheduledAt DateTime
  startedAt   DateTime?
  completedAt DateTime?

  // Results
  result String? // JSON result data
  error  String? // Error message if failed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, priority, scheduledAt])
  @@index([type, userId])
  @@index([scheduledAt])
}
