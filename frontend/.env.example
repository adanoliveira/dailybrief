# Required environment variables for DailyBrief frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secure-nextauth-secret-key

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Authentication Providers (optional for development)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
APPLE_ID=your-apple-client-id
APPLE_SECRET=your-apple-client-secret

# Email Configuration
EMAIL_FROM=noreply@dailybrief.com
# Resend API key for sending emails (https://resend.com)
RESEND_API_KEY=your-resend-api-key

# Database (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@db:5432/dailybrief?schema=auth" 